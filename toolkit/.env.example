LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3-14b

# ── database ─────────────────────────────────────────────────────────────────
# Every database detail lives in this one block. The double underscore is the
# nested-config delimiter: DATABASE__HOST sets settings.database.host.
#
# SQLite (default). NAME is the file path; leave it unset for
# .local-llm-data/calls.db beside the package.
LOCAL_LLM_DATABASE__ENGINE=sqlite
# LOCAL_LLM_DATABASE__NAME=C:/data/calls.db
#
# MySQL / MariaDB. Needs the driver: pip install -e ".[mysql]"
# NAME is the database (schema) name here, not a path.
# LOCAL_LLM_DATABASE__ENGINE=mysql
# LOCAL_LLM_DATABASE__NAME=local_llm
# LOCAL_LLM_DATABASE__HOST=127.0.0.1
# LOCAL_LLM_DATABASE__PORT=3306
# LOCAL_LLM_DATABASE__USER=llm
# LOCAL_LLM_DATABASE__PASSWORD=secret
